{
  "model_family": "LightGBM",
  "owner": "Navjyot",
  "branch": "lightGBM",
  "modes": [
    "standard",
    "regime_aware",
    "regime_aware_mc"
  ],
  "objective_formula": "L(theta) = (1 - lambda) * L_overall + lambda * max_g L_g + eta * Omega(theta)",
  "params": {
    "n_estimators": 150,
    "max_depth": 4,
    "num_leaves": 15,
    "min_child_samples": 20,
    "learning_rate": 0.05,
    "n_jobs": 1,
    "random_state": 42
  },
  "dro_params": {
    "lam": 0.5,
    "eta_step": 0.1,
    "n_dro_iters": 20,
    "mc_samples": 50
  }
}
